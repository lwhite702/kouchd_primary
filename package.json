{
  "name": "kouchd",
  "version": "0.7.23",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "vercel-build": "convex deploy --cmd 'npm run verify && npm run build'",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:env": "node scripts/verify-env.mjs",
    "verify": "npm run verify:env && npm run lint && npm run typecheck && npm run test",
    "version:check": "node scripts/release-version.mjs check",
    "version:prepare": "node scripts/release-version.mjs prepare",
    "lock:status": "node scripts/feature-lock.mjs status",
    "lock:defer-feature": "node scripts/feature-lock.mjs defer-feature",
    "lock:bump-rc": "node scripts/feature-lock.mjs bump-rc",
    "release:check": "npm run version:check && npm run verify && npm run build && node scripts/release-gate.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.1",
    "@knocklabs/node": "^1.35.0",
    "@knocklabs/react": "^0.13.2",
    "@revenuecat/purchases-js": "^1.70.0",
    "@sentry/nextjs": "^11.6.0",
    "@vercel/analytics": "^2.0.1",
    "convex": "1.45.0",
    "lucide-react": "1.40.0",
    "next": "16.4.3",
    "posthog-js": "^1.438.21",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "convex-test": "0.0.56",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
