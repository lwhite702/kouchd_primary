# Browser-safe Convex deployment URL
NEXT_PUBLIC_CONVEX_URL=

# Server-side Loops API key for the main website newsletter signup
LOOPS_API_KEY=

# Clerk application keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex validates Clerk JWTs against this issuer URL.
CLERK_JWT_ISSUER_DOMAIN=

# Set by Vercel. Production and Preview must use separate values.
CONVEX_DEPLOY_KEY=

# Platform Console discovery key (32-64 hex characters) and operator allowlists
PLATFORM_CONSOLE_SLUG=
PLATFORM_ADMIN_EMAILS=
PLATFORM_ADMIN_USER_IDS=
# Older name for PLATFORM_ADMIN_EMAILS, still read as a fallback. Server-only; prefer the new name.
ADMIN_EMAILS=

# Security: Auth bypass toggle (LOCAL/NON-PRODUCTION DEVELOPMENT ONLY)
# WARNING: Do NOT set in production. Unconditionally ignored and blocked in production builds.
# Never expose as a NEXT_PUBLIC_* variable. Legacy flags (NEXT_PUBLIC_DISABLE_AUTH, BYPASS_AUTH) are disabled.
AUTH_BYPASS_ENABLED=false

# PostHog Product Analytics (Optional client telemetry)
# The browser sends events through the app's /ingest proxy (next.config.ts), which
# points at PostHog US. NEXT_PUBLIC_POSTHOG_HOST is only read by the Convex server
# helper (convex/posthog.ts); set both variables on the Convex deployment too.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Meta Pixel (optional). Leave empty until the advertising policy text is
# approved and published; see docs/internal/META_ADS.md.
NEXT_PUBLIC_META_PIXEL_ID=

# Sentry Monitoring & Error Reporting
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=wrelik-0y
SENTRY_PROJECT=kouchd
SENTRY_AUTH_TOKEN=


# Free/Plus stay and guest limits are always enforced.
# Must be configured in both Vercel and Convex deployment environments.
# Set to "production" in production deployments; "sandbox" is permitted for preview/test.
# Required in production; keep blank in template.
SUBSCRIPTION_EXPECTED_ENVIRONMENT=
# Public Web Billing key; test-store keys are not accepted by production checkout.
NEXT_PUBLIC_REVENUECAT_WEB_API_KEY=
NEXT_PUBLIC_REVENUECAT_PLUS_OFFERING_ID=
# RevenueCat App ID and Webhook Authorization Bearer token (Convex environment)
REVENUECAT_APP_ID=
REVENUECAT_WEBHOOK_AUTHORIZATION=

# Knock in-app and transactional notifications (Server-only Convex key)
KNOCK_API_KEY=

# Canonical App URL (leave blank for local dev to default to http://localhost:3000)
# Production: https://app.kouchd.com
NEXT_PUBLIC_APP_URL=

# Convex only: signs Apple's introductory-offer eligibility so one free trial holds
# per host billing account across web and iPhone. Key and issuer come from App Store
# Connect > Users and Access > Integrations > In-App Purchase. Paste the .p8 contents
# on one line with "\n" for line breaks. Never commit real values. Without all four,
# the app shows no trial wording of its own and refuses a purchase where Apple's sheet
# could disagree with Kouchd.
APP_STORE_IAP_KEY_ID=
APP_STORE_IAP_ISSUER_ID=
APP_STORE_BUNDLE_ID=
APP_STORE_IAP_PRIVATE_KEY=

# Freshdesk Customer Support Desk (Server-only; read-only operations)
FRESHDESK_DOMAIN=
FRESHDESK_API_KEY=
FRESHDESK_SUPPORT_EMAIL=



# Knock in-app guides (browser-safe by design: a public API key and a channel id, never the secret KNOCK_API_KEY)
NEXT_PUBLIC_KNOCK_PUBLIC_API_KEY=
NEXT_PUBLIC_KNOCK_GUIDES_CHANNEL_ID=

# Loops signup form id used by the platform console's newsletter check (browser-safe, not a secret).
# PUBLIC_LOOPS_FORM_ID is read first; NEXT_PUBLIC_LOOPS_FORM_ID is the fallback.
PUBLIC_LOOPS_FORM_ID=
NEXT_PUBLIC_LOOPS_FORM_ID=

# Which Vercel environment the browser is running in, for feature-flag defaults (browser-safe).
# Vercel can expose it as NEXT_PUBLIC_VERCEL_ENV through "Automatically expose System Environment Variables".
NEXT_PUBLIC_VERCEL_ENV=
