{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Kouchd Help Center",
  "description": "Guides, ledger management, house rules, and guest agreements for Kouchd.",
  "metadata": {
    "image": "https://kouchd.com/brand/kouchd-icon-square.png",
    "timestamp": false
  },
  "theme": "mint",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "colors": {
    "primary": "#184F3A",
    "light": "#DFF25E",
    "dark": "#123D2E"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#F5F0E8",
      "dark": "#FFFDF8"
    }
  },
  "fonts": {
    "heading": {
      "family": "Manrope"
    },
    "body": {
      "family": "Manrope"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/help/logo/light.svg",
    "dark": "/help/logo/light.svg",
    "href": "https://kouchd.com"
  },
  "favicon": {
    "light": "/help/favicon.svg",
    "dark": "/help/favicon.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Overview",
        "pages": [
          "help/index",
          "help/quickstart",
          "help/faq"
        ],
        "expanded": true
      },
      {
        "group": "For Hosts",
        "pages": [
          "help/hosts/getting-started",
          "help/hosts/stay-terms-and-contributions",
          "help/hosts/house-rules-and-chores",
          "help/hosts/ledger-management"
        ]
      },
      {
        "group": "For Guests",
        "pages": [
          "help/guests/joining-a-stay",
          "help/guests/logging-contributions",
          "help/guests/kouchd-coins"
        ]
      },
      {
        "group": "iPhone app (TestFlight beta)",
        "pages": [
          "help/ios/using-kouchd-on-ios",
          "help/ios/ledger-and-contributions",
          "help/ios/chores-and-stay"
        ]
      },
      {
        "group": "Notifications",
        "pages": [
          "help/notifications/notification-preferences"
        ]
      },
      {
        "group": "Product updates",
        "pages": [
          "help/product/roadmap",
          "help/product/changelog"
        ]
      },
      {
        "group": "Support",
        "pages": [
          "help/support/app-support",
          "help/support/plans-and-subscription",
          "help/support/refund-policy",
          "help/support/delete-account"
        ]
      },
      {
        "group": "Trust & Legal",
        "pages": [
          "help/legal-trust/stay-agreements",
          "help/legal-trust/privacy-and-security",
          "help/legal-trust/terms-of-service"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Open App",
          "href": "https://app.kouchd.com",
          "icon": "house"
        },
        {
          "anchor": "Brand Guide",
          "href": "https://kouchd.com/brand",
          "icon": "palette"
        }
      ]
    }
  },
  "interaction": {
    "drilldown": false
  },
  "search": {
    "prompt": "Search guides, rules, or ledger help..."
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://kouchd.com"
      },
      {
        "label": "Brand Guide",
        "href": "https://kouchd.com/brand"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Kouchd",
      "href": "https://app.kouchd.com"
    }
  },
  "footer": {
    "socials": {
      "website": "https://kouchd.com"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          { "label": "Open Kouchd", "href": "https://app.kouchd.com" },
          { "label": "Brand Guide", "href": "https://kouchd.com/brand" },
          { "label": "Roadmap", "href": "/help/product/roadmap" },
          { "label": "Changelog", "href": "/help/product/changelog" }
        ]
      },
      {
        "header": "Help & trust",
        "items": [
          { "label": "Quickstart", "href": "/help/quickstart" },
          { "label": "App support", "href": "/help/support/app-support" },
          { "label": "Notification settings", "href": "/help/notifications/notification-preferences" },
          { "label": "Privacy & security", "href": "/help/legal-trust/privacy-and-security" }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-light"
      }
    },
    "latex": false
  },
  "thumbnails": {
    "appearance": "light",
    "fonts": {
      "family": "Manrope"
    }
  },
  "seo": {
    "indexing": "navigable"
  },
  "errors": {
    "404": {
      "redirect": true
    }
  }
}
