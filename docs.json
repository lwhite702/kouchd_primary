{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Kouchd Help Center",
  "description": "Guides, ledger management, house rules, and guest agreements for Kouchd.",
  "theme": "mint",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "colors": {
    "primary": "#184F3A",
    "light": "#22C55E",
    "dark": "#103627"
  },
  "background": {
    "color": {
      "light": "#FFFDF8",
      "dark": "#FFFDF8"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/help/logo/light.svg",
    "dark": "/help/logo/light.svg",
    "href": "https://kouchd.com"
  },
  "favicon": {
    "light": "/help/favicon.svg",
    "dark": "/help/favicon.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Overview",
        "pages": [
          "help/index",
          "help/quickstart"
        ],
        "expanded": true
      },
      {
        "group": "For Hosts",
        "pages": [
          "help/hosts/getting-started",
          "help/hosts/pricing-and-terms",
          "help/hosts/house-rules-and-chores",
          "help/hosts/ledger-management"
        ]
      },
      {
        "group": "For Guests",
        "pages": [
          "help/guests/joining-a-stay",
          "help/guests/logging-contributions",
          "help/guests/kouchd-coins"
        ]
      },
      {
        "group": "Trust & Legal",
        "pages": [
          "help/legal-trust/stay-agreements",
          "help/legal-trust/privacy-and-security"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Open App",
          "href": "https://kouchd.com",
          "icon": "house"
        }
      ]
    }
  },
  "interaction": {
    "drilldown": false
  },
  "search": {
    "prompt": "Search guides, rules, or ledger help..."
  },
  "navbar": {
    "links": [
      {
        "label": "Web App",
        "href": "https://kouchd.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Kouchd",
      "href": "https://kouchd.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-light"
      }
    },
    "latex": false
  },
  "metadata": {
    "timestamp": false
  },
  "thumbnails": {
    "appearance": "light",
    "fonts": {
      "family": "Manrope"
    }
  },
  "seo": {
    "indexing": "navigable"
  },
  "errors": {
    "404": {
      "redirect": true
    }
  }
}
