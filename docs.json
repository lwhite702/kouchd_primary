{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Kouchd Help Center",
  "description": "Plain, practical help for hosts and guests using Kouchd.",
  "theme": "mint",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "colors": {
    "primary": "#184F3A",
    "light": "#DFF25E",
    "dark": "#123D2E"
  },
  "background": {
    "color": {
      "light": "#F5F0E8",
      "dark": "#0F1914"
    }
  },
  "fonts": {
    "heading": {
      "family": "Manrope"
    },
    "body": {
      "family": "Manrope"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/help/logo/light.svg",
    "dark": "/help/logo/dark.svg",
    "href": "https://kouchd.com"
  },
  "favicon": {
    "light": "/help/favicon.svg",
    "dark": "/help/favicon.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Overview",
        "expanded": true,
        "pages": [
          "help/index",
          "help/quickstart",
          "help/faq"
        ]
      },
      {
        "group": "For hosts",
        "pages": [
          "help/hosts/getting-started",
          "help/hosts/inviting-guests",
          "help/hosts/pricing-and-terms",
          "help/hosts/schedules-and-overnights",
          "help/hosts/ledger-management",
          "help/hosts/house-rules-and-chores",
          "help/hosts/managing-your-stay",
          "help/hosts/plans-and-limits"
        ]
      },
      {
        "group": "For guests",
        "pages": [
          "help/guests/joining-a-stay",
          "help/guests/logging-contributions",
          "help/guests/kouchd-coins"
        ]
      },
      {
        "group": "Around the house",
        "pages": [
          "help/household/house-guide",
          "help/household/shopping-list",
          "help/household/check-ins",
          "help/household/announcements-and-activity"
        ]
      },
      {
        "group": "iPhone app",
        "pages": [
          "help/ios/using-kouchd-on-ios",
          "help/ios/ledger-and-contributions",
          "help/ios/chores-and-stay"
        ]
      },
      {
        "group": "Notifications",
        "pages": [
          "help/notifications/notification-preferences"
        ]
      },
      {
        "group": "Product updates",
        "pages": [
          "help/product/roadmap",
          "help/product/changelog"
        ]
      },
      {
        "group": "Support",
        "pages": [
          "help/support/app-support"
        ]
      },
      {
        "group": "Trust and legal",
        "pages": [
          "help/legal-trust/stay-agreements",
          "help/legal-trust/privacy-and-security",
          "help/legal-trust/terms-of-service"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Open Kouchd",
          "href": "https://app.kouchd.com",
          "icon": "house"
        },
        {
          "anchor": "kouchd.com",
          "href": "https://kouchd.com",
          "icon": "globe"
        }
      ]
    }
  },
  "interaction": {
    "drilldown": false
  },
  "search": {
    "prompt": "Search stays, the Ledger, chores..."
  },
  "navbar": {
    "links": [
      {
        "label": "kouchd.com",
        "href": "https://kouchd.com"
      },
      {
        "label": "Plans",
        "href": "https://kouchd.com/pricing"
      },
      {
        "label": "Room to Share",
        "href": "https://kouchd.com/blog"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Kouchd",
      "href": "https://app.kouchd.com"
    }
  },
  "footer": {
    "socials": {
      "website": "https://kouchd.com"
    },
    "links": [
      {
        "header": "Kouchd",
        "items": [
          {
            "label": "Open Kouchd",
            "href": "https://app.kouchd.com"
          },
          {
            "label": "kouchd.com",
            "href": "https://kouchd.com"
          },
          {
            "label": "Plans",
            "href": "https://kouchd.com/pricing"
          },
          {
            "label": "Room to Share",
            "href": "https://kouchd.com/blog"
          }
        ]
      },
      {
        "header": "Help",
        "items": [
          {
            "label": "Quickstart",
            "href": "/help/quickstart"
          },
          {
            "label": "FAQ",
            "href": "/help/faq"
          },
          {
            "label": "App support",
            "href": "/help/support/app-support"
          },
          {
            "label": "Changelog",
            "href": "/help/product/changelog"
          }
        ]
      },
      {
        "header": "Legal",
        "items": [
          {
            "label": "Privacy",
            "href": "https://kouchd.com/privacy"
          },
          {
            "label": "Terms",
            "href": "https://kouchd.com/terms"
          }
        ]
      }
    ]
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    },
    "latex": false
  },
  "metadata": {
    "timestamp": false
  },
  "thumbnails": {
    "appearance": "light",
    "fonts": {
      "family": "Manrope"
    }
  },
  "seo": {
    "indexing": "navigable"
  },
  "errors": {
    "404": {
      "redirect": true
    }
  },
  "redirects": [
    {
      "source": "/help/using-notifications",
      "destination": "/help/notifications/notification-preferences"
    },
    {
      "source": "/quickstart",
      "destination": "/help/quickstart"
    }
  ]
}
